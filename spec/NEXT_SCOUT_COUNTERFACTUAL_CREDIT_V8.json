  "purpose": "Estimate conservative matched observational prep-effect candidates from delayed V7 outcomes without converting association into causal proof or silently mutating the scout economy.",
  "inputs": {
    "treated": "V7 completed-focus outcome receipt containing target prep kind",
    "control": "distinct V7 completed-focus outcome receipt not containing target prep kind",
