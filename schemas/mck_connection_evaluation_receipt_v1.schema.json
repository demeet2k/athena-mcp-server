{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ATHENA.MCK.CONNECTION.EVALUATION.RECEIPT.V1",
  "title": "ATHENA MCK Connection Evaluation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "artifact",
    "version",
    "revision",
    "standing",
    "packet_artifact",
    "packet_version",
    "packet_compiler_revision",
    "packet_semantic_digest",
    "operator_registry_digest",
    "semantic_control_artifact",
    "initial_state",
    "initial_state_digest",
    "ordered_path",
    "ordered_path_digest",
    "raw_result",
    "raw_result_digest",
    "semantic_result",
    "semantic_result_digest",
    "semantic_result_projection_basis",
    "source_evidence",
    "historical_mapping",
    "implementation_binding",
    "expected_class_used",
    "laws",
    "evaluation_receipt_digest"
  ],
  "properties": {
    "status": {"const": "EVALUATED"},
    "artifact": {"const": "ATHENA.MCK.CONNECTION.EVALUATION.RECEIPT.V1"},
    "version": {"const": "MCK.CONNECTION.EVALUATION.RECEIPT.V1"},
    "revision": {"const": "SEMANTIC_CONTROL_FUSION_R1"},
    "standing": {"const": "SYNTHETIC_REPLAY_RECEIPT_NOT_EXTERNAL_IMPLEMENTATION_WITNESS"},
    "packet_artifact": {"const": "ATHENA.MCK.CONNECTION.OPERATOR_PACKET.V1"},
    "packet_version": {"const": "MCK.CONNECTION.PACKET.V1"},
    "packet_compiler_revision": {"type": "string", "minLength": 1},
    "packet_semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_control_artifact": {"const": "ATHENA.AQ001C.SEMANTIC_CONNECTION_CONTROL.V1"},
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "feature_basis",
        "values",
        "irreversible_loss",
        "standing",
        "provenance"
      ],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "feature_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "values": {"type": "object"},
        "irreversible_loss": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "standing": {"const": "SYNTHETIC_CONTROL"},
        "provenance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "initial_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ordered_path": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ordered_path_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_result": {"type": "object"},
    "raw_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "standing",
        "classification",
        "reason",
        "initial_state",
        "final_state",
        "residue",
        "residue_zero"
      ],
      "properties": {
        "artifact": {"const": "ATHENA.AQ001C.SEMANTIC_CONNECTION_CONTROL.V1"},
        "standing": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "initial_state": {"$ref": "#/$defs/semanticState"},
        "final_state": {
          "oneOf": [
            {"$ref": "#/$defs/semanticState"},
            {"type": "null"}
          ]
        },
        "residue": {
          "oneOf": [
            {"type": "object"},
            {"type": "null"}
          ]
        },
        "residue_zero": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        }
      }
    },
    "semantic_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_result_projection_basis": {
      "const": "runtime_result minus executed_edges/audit/provenance; includes artifact, standing, classification, reason, initial/final public semantics, residue, residue_zero"
    },
    "source_evidence": {"const": "NONE_SYNTHETIC_CONTROL"},
    "historical_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "edges"],
      "properties": {
        "status": {"const": "HOLD_EMPTY_V1_PROPOSAL"},
        "edges": {"type": "array", "maxItems": 0}
      }
    },
    "implementation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standing",
        "repository",
        "git_head",
        "ci_workflow",
        "ci_run_id",
        "ci_run_number",
        "ci_conclusion"
      ],
      "properties": {
        "standing": {"const": "EXTERNAL_BINDING_REQUIRED"},
        "repository": {"type": "null"},
        "git_head": {"type": "null"},
        "ci_workflow": {"type": "null"},
        "ci_run_id": {"type": "null"},
        "ci_run_number": {"type": "null"},
        "ci_conclusion": {"type": "null"}
      }
    },
    "expected_class_used": {"const": false},
    "laws": {
      "type": "array",
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "SELF_GENERATED_RECEIPT != REPOSITORY_CI_WITNESS"}},
        {"contains": {"const": "AUDIT_TRACE_DIGEST != SEMANTIC_RESULT_DIGEST"}},
        {"contains": {"const": "DECLARED_TYPED_LOSS != EXECUTED_IRREVERSIBLE_LOSS"}}
      ]
    },
    "evaluation_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "feature_basis",
        "values",
        "irreversible_loss",
        "standing"
      ],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "feature_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "values": {"type": "object"},
        "irreversible_loss": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "standing": {"const": "SYNTHETIC_CONTROL"}
      }
    }
  }
}
