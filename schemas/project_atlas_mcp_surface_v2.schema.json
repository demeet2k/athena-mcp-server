{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/project_atlas_mcp_surface_v2.schema.json",
  "title": "ATHENA KC144 Project Atlas MCP Surface Contract V2",
  "type": "object",
  "required": [
    "schema",
    "status",
    "surface_version",
    "base_v1",
    "integration",
    "surface",
    "frontier",
    "query_index",
    "snapshot",
    "planes",
    "list_sources",
    "resolve",
    "route",
    "hold_statuses",
    "laws",
    "promotion"
  ],
  "properties": {
    "schema": {"const": "ATHENA.KC144.PROJECT_ATLAS.MCP_SURFACE.CONTRACT.v2"},
    "status": {"const": "CANDIDATE_CHILD_OF_UNMERGED_V1"},
    "surface_version": {"const": "ATHENA.PROJECT_ATLAS.MCP_SURFACE.V2"},
    "base_v1": {
      "type": "object",
      "required": ["repository", "pull_request", "head", "branch"],
      "properties": {
        "repository": {"const": "demeet2k/athena-mcp-server"},
        "pull_request": {"const": 295},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"const": "agent/kc144-project-atlas-v1"}
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["branch", "child_pull_request", "qualification_only_pull_request", "head_binding", "law"],
      "properties": {
        "branch": {"const": "agent/kc144-project-atlas-mcp-surface-v2"},
        "child_pull_request": {"const": 310},
        "qualification_only_pull_request": {"const": 311},
        "head_binding": {"type": "string", "minLength": 1},
        "law": {"const": "QUALIFICATION_PR != INTEGRATION_PR"}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["tools", "resource", "max_page", "default_page", "read_only", "self_metering"],
      "properties": {
        "tools": {
          "type": "array",
          "const": [
            "athena_project_atlas_summary",
            "athena_project_resolve",
            "athena_project_list",
            "athena_project_route"
          ]
        },
        "resource": {"const": "athena://project-atlas"},
        "max_page": {"const": 100},
        "default_page": {"const": 50},
        "read_only": {"const": true},
        "self_metering": {"const": false}
      },
      "additionalProperties": false
    },
    "frontier": {
      "type": "object",
      "required": ["factorization", "configured_git_source", "runtime_source_priority", "runtime_head_attestation_without_tree", "unknown_runtime_tree_law", "cache_key", "bounded_retry"],
      "properties": {
        "factorization": {"const": ["CONFIGURED_GIT_HEAD", "RUNTIME_SOURCE_FRONTIER", "LIVE_MCP_SURFACE_SIGNATURE"]},
        "configured_git_source": {"const": "ATHENA_GIT_ROOT"},
        "runtime_source_priority": {"const": ["ATHENA_RUNTIME_GIT_ROOT", "PACKAGE_SOURCE_CHECKOUT", "ATHENA_RUNTIME_REPOSITORY+ATHENA_RUNTIME_GIT_HEAD", "HOLD_RUNTIME_PROVENANCE"]},
        "runtime_head_attestation_without_tree": {"const": "PARTIAL_RUNTIME_TREE_UNAVAILABLE"},
        "unknown_runtime_tree_law": {"const": "UNKNOWN_RUNTIME_TREE != EMPTY_RUNTIME_TREE"},
        "cache_key": {"const": "<configured_git_head,runtime_source_frontier,live_mcp_surface_signature>"},
        "bounded_retry": {"const": 1}
      },
      "additionalProperties": false
    },
    "query_index": {
      "type": "object",
      "required": ["version", "maps", "digest_in_snapshot", "order_invariant", "duplicate_invariant", "law"],
      "properties": {
        "version": {"const": "ATHENA.PROJECT_ATLAS.QUERY_INDEX.V2"},
        "maps": {
          "const": [
            "by_source",
            "by_poid",
            "by_address",
            "by_return",
            "by_path",
            "by_raw_mcp_name",
            "by_typed_mcp",
            "by_project_gid",
            "by_reference_gid",
            "by_directory",
            "by_blob"
          ]
        },
        "digest_in_snapshot": {"const": true},
        "order_invariant": {"const": true},
        "duplicate_invariant": {"const": true},
        "law": {"const": "QUERY_INDEX != SEMANTIC_IDENTITY"}
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["prefix", "basis", "authority", "law"],
      "properties": {
        "prefix": {"const": "PATLASV2."},
        "basis": {
          "const": [
            "configured_repo_head_tree_atlas_digest",
            "runtime_provenance",
            "runtime_git_head_tree_atlas_digest_if_available",
            "mcp_repo_head_surface_digest",
            "live_mcp_surface_signature",
            "query_index_digest",
            "federation_digest"
          ]
        },
        "authority": {"const": "NONE"},
        "law": {"const": "PROJECT_ATLAS_SNAPSHOT_ID != PROMOTION_RECEIPT"}
      },
      "additionalProperties": false
    },
    "planes": {"const": ["configured_git", "runtime_git", "mcp"]},
    "list_sources": {"const": ["all", "git", "configured_git", "runtime_git", "mcp"]},
    "resolve": {
      "type": "object",
      "required": ["exact_identifiers", "open_world_identifiers", "typed_mcp_prefixes", "ambiguous", "not_found_complete_universe", "not_found_runtime_provenance_unknown", "not_found_runtime_tree_unknown"],
      "properties": {
        "ambiguous": {"const": "HOLD_AMBIGUOUS"},
        "not_found_complete_universe": {"const": "HOLD_NOT_FOUND"},
        "not_found_runtime_provenance_unknown": {"const": "HOLD_RUNTIME_PROVENANCE"},
        "not_found_runtime_tree_unknown": {"const": "HOLD_RUNTIME_TREE_UNAVAILABLE"}
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": ["normal", "toroidal", "cross_frontier_receipt", "native_return_both_endpoints", "law"],
      "properties": {
        "normal": {"const": "PROJECT_KC144_ROW_THEN_COLUMN"},
        "toroidal": {"const": "PROJECT_KC144_12x12_WRAP"},
        "cross_frontier_receipt": {"const": true},
        "native_return_both_endpoints": {"const": true},
        "law": {"const": "PROJECT_ROUTE != SEMANTIC_EQUIVALENCE"}
      },
      "additionalProperties": false
    },
    "hold_statuses": {
      "type": "array",
      "const": [
        "HOLD_GIT_UNAVAILABLE",
        "HOLD_STALE_CONFIGURED_HEAD",
        "HOLD_STALE_RUNTIME_HEAD",
        "HOLD_RUNTIME_PROVENANCE",
        "HOLD_RUNTIME_TREE_UNAVAILABLE",
        "HOLD_VOLATILE_FRONTIER",
        "HOLD_NOT_FOUND",
        "HOLD_AMBIGUOUS",
        "HOLD_ROUTE_SOURCE",
        "HOLD_ROUTE_DESTINATION"
      ]
    },
    "laws": {
      "type": "array",
      "minItems": 25,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "promotion": {
      "type": "object",
      "required": ["standing", "package_version_change_in_child", "canonical_rpc_promotion", "publication", "deployment", "requirements"],
      "properties": {
        "standing": {"const": "HOLD_PENDING_V1_ACCEPTANCE_REBASE_AND_NEW_ABI_QUALIFICATION"},
        "package_version_change_in_child": {"const": false},
        "canonical_rpc_promotion": {"const": false},
        "publication": {"const": false},
        "deployment": {"const": false},
        "requirements": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
