{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/mck_evaluation_receipt_v1.schema.json",
  "title": "ATHENA MCK Evaluation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "version",
    "status",
    "receipt_id",
    "receipt_standing",
    "evidence_standing",
    "source_evidence",
    "historical_mapping",
    "independent_witness",
    "authority_delta",
    "ci_qualification",
    "semantic_control_artifact",
    "packet_compiler_revision",
    "packet_semantic_digest",
    "operator_registry_digest",
    "initial_state",
    "edge_path",
    "evaluation_input_digest",
    "raw_result",
    "raw_result_digest",
    "receipt_digest"
  ],
  "properties": {
    "artifact": {
      "const": "ATHENA.MCK.EVALUATION.RECEIPT.V1"
    },
    "version": {
      "const": "MCK.EVALUATION.RECEIPT.V1"
    },
    "status": {
      "const": "RECORDED"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^MCK-EVAL-[0-9a-f]{24}$"
    },
    "receipt_standing": {
      "const": "SYNTHETIC_REPLAY_RECEIPT_NOT_SOURCE_EVIDENCE"
    },
    "evidence_standing": {
      "const": "REPOSITORY_EXECUTED_SYNTHETIC_CONTROL"
    },
    "source_evidence": {
      "const": "NONE_SYNTHETIC_CONTROL"
    },
    "historical_mapping": {
      "const": "HOLD_EMPTY_V1_PROPOSAL"
    },
    "independent_witness": {
      "const": false
    },
    "authority_delta": {
      "const": "NONE"
    },
    "ci_qualification": {
      "const": "NOT_INFERRED_BY_RECEIPT"
    },
    "semantic_control_artifact": {
      "const": "ATHENA.AQ001C.SEMANTIC_CONNECTION_CONTROL.V1"
    },
    "packet_compiler_revision": {
      "const": "SEMANTIC_CONTROL_FUSION_R1"
    },
    "packet_semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initial_state": {
      "type": "object",
      "required": [
        "coordinate",
        "feature_basis",
        "values",
        "irreversible_loss",
        "standing",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "string",
          "minLength": 1
        },
        "feature_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "object"
        },
        "irreversible_loss": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "standing": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edge_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_result": {
      "type": "object"
    },
    "raw_result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
