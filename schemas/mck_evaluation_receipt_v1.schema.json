{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/mck_evaluation_receipt_v1.schema.json",
  "title": "ATHENA MCK Evaluation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact", "version", "status", "receipt_id", "receipt_standing",
    "evidence_standing", "source_evidence", "historical_mapping",
    "independent_witness", "authority_delta", "ci_qualification",
    "implementation_binding", "semantic_control_artifact",
    "packet_compiler_revision", "packet_semantic_digest",
    "operator_registry_digest", "initial_state", "initial_state_digest",
    "edge_path", "ordered_path_digest", "evaluation_input_digest",
    "raw_result", "raw_result_digest", "semantic_result",
    "semantic_result_digest", "semantic_result_projection_basis",
    "receipt_digest"
  ],
  "properties": {
    "artifact": {"const": "ATHENA.MCK.EVALUATION.RECEIPT.V1"},
    "version": {"const": "MCK.EVALUATION.RECEIPT.V1"},
    "status": {"const": "RECORDED"},
    "receipt_id": {"type": "string", "pattern": "^MCK-EVAL-[0-9a-f]{24}$"},
    "receipt_standing": {"const": "SYNTHETIC_REPLAY_RECEIPT_NOT_EXTERNAL_IMPLEMENTATION_WITNESS"},
    "evidence_standing": {"const": "SYNTHETIC_CONTROL_EXECUTION_ONLY"},
    "source_evidence": {"const": "NONE_SYNTHETIC_CONTROL"},
    "historical_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "edges"],
      "properties": {
        "status": {"const": "HOLD_EMPTY_V1_PROPOSAL"},
        "edges": {"type": "array", "maxItems": 0}
      }
    },
    "independent_witness": {"const": false},
    "authority_delta": {"const": "NONE"},
    "ci_qualification": {"const": "NOT_INFERRED_BY_RECEIPT"},
    "implementation_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["standing", "repository", "git_head", "ci_workflow", "ci_run_id", "ci_run_number", "ci_conclusion"],
      "properties": {
        "standing": {"const": "EXTERNAL_BINDING_REQUIRED"},
        "repository": {"type": "null"},
        "git_head": {"type": "null"},
        "ci_workflow": {"type": "null"},
        "ci_run_id": {"type": "null"},
        "ci_run_number": {"type": "null"},
        "ci_conclusion": {"type": "null"}
      }
    },
    "semantic_control_artifact": {"const": "ATHENA.AQ001C.SEMANTIC_CONNECTION_CONTROL.V1"},
    "packet_compiler_revision": {"const": "SEMANTIC_CONTROL_FUSION_R1"},
    "packet_semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initial_state": {"$ref": "#/$defs/auditState"},
    "initial_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "edge_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ordered_path_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_result": {"type": "object"},
    "raw_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_result": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "standing", "classification", "reason", "initial_state", "final_state", "residue", "residue_zero"],
      "properties": {
        "artifact": {"const": "ATHENA.AQ001C.SEMANTIC_CONNECTION_CONTROL.V1"},
        "standing": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "initial_state": {"$ref": "#/$defs/semanticState"},
        "final_state": {"oneOf": [{"$ref": "#/$defs/semanticState"}, {"type": "null"}]},
        "residue": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "residue_zero": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}
      }
    },
    "semantic_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_result_projection_basis": {"const": "runtime_result minus executed_edges/audit/provenance; includes artifact, standing, classification, reason, initial/final public semantics, residue, residue_zero"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "semanticState": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate", "feature_basis", "values", "irreversible_loss", "standing"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "feature_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "values": {"type": "object"},
        "irreversible_loss": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "standing": {"const": "SYNTHETIC_CONTROL"}
      }
    },
    "auditState": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate", "feature_basis", "values", "irreversible_loss", "standing", "provenance"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "feature_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "values": {"type": "object"},
        "irreversible_loss": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "standing": {"const": "SYNTHETIC_CONTROL"},
        "provenance": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
